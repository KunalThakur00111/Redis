{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure redis-server",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build redis-server",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure redis-server",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
